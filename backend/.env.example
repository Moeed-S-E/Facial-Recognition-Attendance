# Copy to .env for local development. Never commit real credentials.
APP_NAME=Facial Recognition Attendance API
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ATTENDANCE_RETENTION_MODE=local-only
ATTENDANCE_LATE_AFTER_MINUTES=540
MAX_EVIDENCE_BYTES=6291456
MAX_EMPLOYEE_ID_LENGTH=128

# Optional local cache settings.
VALKEY_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_BACKOFF_SECONDS=900
PUBLIC_RATE_LIMIT_PER_IP=60
AUTHENTICATED_RATE_LIMIT_PER_ACCOUNT=120
AUTH_RATE_LIMIT_PER_IP=10
AUTH_RATE_LIMIT_PER_ACCOUNT=5
DEMO_RATE_LIMIT_PER_IP=10

# FaceNet cosine-distance threshold for employee verification.
EMPLOYEE_FACE_THRESHOLD=0.5
JWT_SECRET=
PASSWORD_PEPPER=
EVIDENCE_STORAGE_DIR=./var/facial-recognition-attendance/evidence

# Local database. SQLite is used when this variable is omitted.
# DATABASE_URL=sqlite+aiosqlite:///./facial_recognition_attendance.db

NOTIFICATIONS_ENABLED=true
NOTIFICATION_WS_PATH=/v1/notifications/ws
NOTIFICATION_WS_TOKEN=
NOTIFICATION_WS_ALLOW_UNAUTHENTICATED_DEVELOPMENT=false
