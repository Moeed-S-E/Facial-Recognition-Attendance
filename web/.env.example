# Copy to .env.local for local development.
# Keep database, storage, and authentication secrets out of this browser environment file.
VITE_API_BASE_URL=http://localhost:8000
VITE_NOTIFICATION_WS_URL=ws://localhost:8000/v1/notifications/ws
# Optional override when constructing the websocket URL from the API URL.
# Defaults to /v1/notifications/ws when omitted.
# VITE_NOTIFICATION_WS_PATH=/v1/notifications/ws
#
